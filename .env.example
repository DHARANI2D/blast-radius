# --- LLM endpoint (HPE-approved only) ---------------------------------------
# offline : deterministic stand-ins, no network (default; demo + tests)
# openai  : any OpenAI-compatible endpoint, e.g. NVIDIA NIM on HPE Private Cloud AI
#           or an HPE GenAI Hub / ChatHPE gateway that speaks the OpenAI API
# azure   : Azure OpenAI URL scheme (deployment name in BR_LLM_MODEL)
BR_LLM_MODE=offline
BR_LLM_BASE_URL=
BR_LLM_API_KEY=
BR_LLM_MODEL=
BR_LLM_API_VERSION=2024-10-21

# Independent Verifier (recommended: a different model than the planner)
BR_VERIFIER_MODEL=
BR_VERIFIER_BASE_URL=
BR_VERIFIER_API_KEY=

# --- Tools -------------------------------------------------------------------
BR_TOOL_TRANSPORT=mcp          # mcp | inproc
# Injected fault scenario (the agents cannot see it; they only observe telemetry):
#   on      ROM v2.32 + NIC 229.x regression (~4x), caught by the cohort canary
#   subtle  ~1.3x regression below the 2x threshold, caught only by the statistical judge
#   backup  a backup job slows every host (common-mode, no fault): must NOT roll back
#   on+backup, subtle+backup, off
BR_FAULTS=on
BR_KILL_SWITCH=off             # on = block every write action

# Optional: official HPE GreenLake MCP server (HewlettPackard/gl-mcp), read-only
# Check with: python -m blastradius greenlake doctor
BR_GL_MCP_URL=                 # streamable-HTTP endpoint, or
BR_GL_MCP_CMD=                 # stdio command, e.g. "uv run python -m src.server"
BR_GL_MCP_CWD=                 # working directory for BR_GL_MCP_CMD (a gl-mcp devices checkout)
BR_GL_MCP_DEVICES_TOOL=        # default getdevicesv1
BR_GL_MCP_FILTER=              # OData filter, e.g. deviceType eq 'COMPUTE'
BR_GL_MCP_PAGE_SIZE=2000
BR_GL_MCP_MAX_PAGES=10
BR_GL_MCP_TIMEOUT_S=60

# --- Governance --------------------------------------------------------------
BR_SIGNING_KEY=change-me-for-anything-beyond-a-demo
